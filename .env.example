# Copy this file to .env.local for local development.
# On Netlify, set the same keys under Site settings → Environment variables.

# --- Content management (Decap / Sveltia CMS) ---
# The CMS authenticates through your Git provider (GitHub) via OAuth.
# These belong in the Netlify dashboard, NOT in the committed repo.
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# --- Student portal / LMS (Supabase) ---
# From Supabase → Project Settings → API.

# Safe to expose to the browser. The anon key grants nothing on its own:
# every table has Row Level Security enabled and denies by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security completely — it can read and write every
# row in the database. Only ever set this as a server-side environment variable.
# Never prefix it with NEXT_PUBLIC_, never paste it into client code, and rotate
# it immediately if it is ever committed or shared.
SUPABASE_SERVICE_ROLE_KEY=

# --- Teacher approval ---
# Where teacher approval codes are emailed. This should be an inbox the NGO
# office actually watches — whoever reads it decides who becomes a teacher.
NGO_APPROVAL_EMAIL=

# Email delivery for those codes (https://resend.com — free tier is plenty).
# Without these, codes are printed to the server log in development and the
# teacher signup route refuses to run in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
